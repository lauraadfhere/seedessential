{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tannelli-response-store",
  "main": "./node_modules/@cloudflare/workers-response-store/dist/service.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_ctx_exports"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "cache": {
    "enabled": false
  },
  "exports": {
    "default": {
      "type": "worker",
      "cache": {
        "enabled": false
      }
    },
    "ResponseStoreBinding": {
      "type": "worker",
      "cache": {
        "enabled": true
      }
    },
    "CacheMetadata": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "r2_buckets": [
    {
      "binding": "CACHE_BODIES",
      "bucket_name": "tannelli-response-store-cache-bodies"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CACHE_METADATA",
        "class_name": "CacheMetadata"
      }
    ]
  }
}
