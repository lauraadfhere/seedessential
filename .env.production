# Public, browser-safe configuration inlined into the client bundle at build time.
# These identifiers ship to every visitor by design (Parse app id / JS key,
# Cloudinary cloud name), so this file is committed on purpose.
# NEVER add PARSE_MASTER_KEY, CLOUDINARY_API_SECRET or any other secret here —
# those belong in `.env.local` for local work and in Worker secrets in production.

NEXT_PUBLIC_PARSE_APP_ID=rrbodmxViK4CBzFVzG5mK7AkFNRcRoMiJAcs9RGQ
NEXT_PUBLIC_PARSE_JS_KEY=R8lmfcjTXOxRYlLHO2YpaCLtHqPNcs33gNQjNpCD
NEXT_PUBLIC_PARSE_SERVER_URL=https://parseapi.back4app.com/

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=n08p7st8

# Set to "true" once tannelli/watermark_logo exists in Cloudinary.
NEXT_PUBLIC_ENABLE_WATERMARK=false
