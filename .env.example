# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must never be committed.

# --- Parse / Back4App ------------------------------------------------------
NEXT_PUBLIC_PARSE_APP_ID=
NEXT_PUBLIC_PARSE_JS_KEY=
NEXT_PUBLIC_PARSE_SERVER_URL=https://parseapi.back4app.com/

# Server-only secrets — never prefix these with NEXT_PUBLIC_
PARSE_CLIENT_KEY=
PARSE_MASTER_KEY=

# --- Cloudinary --------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Server-only secrets
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# --- NVIDIA NIM (RuddgeAI) ---------------------------------------------------
# Server-only. Create a free key at https://build.nvidia.com/settings
# NVIDIA_API_KEY=

# Enable watermark on plant images (set to "true" after uploading watermark_logo to Cloudinary)
# Leave as "false" until you upload tannelli/watermark_logo to your Cloudinary account
NEXT_PUBLIC_ENABLE_WATERMARK=false

# --- Database ----------------------------------------------------------------
DATABASE_URL=mysql://username:password@localhost:3306/tannelli
